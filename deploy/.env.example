# Copy to deploy/.env and edit. docker compose reads it automatically.
# Everything has a working default; set only what you want to change.

# --- where the index lives ----------------------------------------------------
# A host path (bind mount, easy to inspect and back up) or nothing, in which
# case the named docker volume `osureco-index` is used.
#OSURECO_HOST_DATA=/srv/osureco/data
# uid:gid the container runs as. With a bind mount it MUST own that folder,
# otherwise the setup jobs cannot write the index. `id -u`, `id -g`.
#OSURECO_UID=1000
#OSURECO_GID=1000

# --- where it listens ---------------------------------------------------------
# Keep it on localhost and let a reverse proxy or a tunnel reach it.
#OSURECO_BIND=127.0.0.1:8080
#OSURECO_CONTAINER=osureco-api
#OSURECO_WORKERS=1

# --- what it serves -----------------------------------------------------------
#OSURECO_API_VARIANTS=nomod,DT,HR,DTHR,HT
#OSURECO_API_CORS=*
#OSURECO_API_RATE=120
#OSURECO_API_BURST=60
#OSURECO_API_FILE_COST=5
#OSURECO_API_MAX_UPLOAD=4000000
#OSURECO_API_TRUST_PROXY=1
#OSURECO_API_DOCS=1

# Leave empty for a public API; set it to require Authorization: Bearer <token>
#OSURECO_API_TOKEN=

# Mirror to download prebuilt indexes from (full URL, or a prefix ending in /)
#OSURECO_INDEX_URL=
