# Copy to deploy/.env and edit. docker compose reads it automatically.
# Everything has a working default; set only what you want to change.

# --- where the index lives ----------------------------------------------------
# A host path (bind mount, easy to inspect and back up) or nothing, in which
# case the named docker volume `osu-mapmatcher-index` is used.
#OSUMAPMATCHER_HOST_DATA=/srv/osu-mapmatcher/data
# uid:gid the container runs as. With a bind mount it MUST own that folder,
# otherwise the setup jobs cannot write the index. `id -u`, `id -g`.
#OSUMAPMATCHER_UID=1000
#OSUMAPMATCHER_GID=1000

# --- where it listens ---------------------------------------------------------
# Keep it on localhost and let a reverse proxy or a tunnel reach it.
#OSUMAPMATCHER_BIND=127.0.0.1:8080
#OSUMAPMATCHER_CONTAINER=osu-mapmatcher-api
#OSUMAPMATCHER_WORKERS=1

# --- what it serves -----------------------------------------------------------
#OSUMAPMATCHER_API_VARIANTS=nomod,DT,HR,DTHR,HT
#OSUMAPMATCHER_API_CORS=*
#OSUMAPMATCHER_API_RATE=120
#OSUMAPMATCHER_API_BURST=60
#OSUMAPMATCHER_API_FILE_COST=5
#OSUMAPMATCHER_API_MAX_UPLOAD=4000000
#OSUMAPMATCHER_API_TRUST_PROXY=1
#OSUMAPMATCHER_API_DOCS=1

# Leave empty for a public API; set it to require Authorization: Bearer <token>
#OSUMAPMATCHER_API_TOKEN=

# Mirror to download prebuilt indexes from (full URL, or a prefix ending in /)
#OSUMAPMATCHER_INDEX_URL=
