# /etc/systemd/system/osu-mapmatcher-api.service
#
#   sudo useradd --system --home /var/lib/osu-mapmatcher --create-home osu-mapmatcher
#   sudo git clone https://github.com/Ayreth/OsuMapMatcher /opt/osu-mapmatcher
#   sudo python3 -m venv /opt/osu-mapmatcher/.venv
#   sudo /opt/osu-mapmatcher/.venv/bin/pip install -e "/opt/osu-mapmatcher[api]"
#   sudo -u osu-mapmatcher OSUMAPMATCHER_DATA=/var/lib/osu-mapmatcher \
#        /opt/osu-mapmatcher/.venv/bin/python /opt/osu-mapmatcher/scripts/fetch_index.py
#   sudo systemctl enable --now osu-mapmatcher-api

[Unit]
Description=osu!MapMatcher API
Documentation=https://github.com/Ayreth/OsuMapMatcher
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=osu-mapmatcher
Group=osu-mapmatcher
WorkingDirectory=/opt/osu-mapmatcher
Environment=OSUMAPMATCHER_DATA=/var/lib/osu-mapmatcher
Environment=OSUMAPMATCHER_API_VARIANTS=nomod
Environment=OSUMAPMATCHER_API_CORS=*
Environment=OSUMAPMATCHER_API_RATE=120
Environment=OSUMAPMATCHER_API_TRUST_PROXY=1
# secrets et surcharges locales, absence toleree (le tiret)
EnvironmentFile=-/etc/osu-mapmatcher/api.env
ExecStart=/opt/osu-mapmatcher/.venv/bin/uvicorn osumapmatcher.api:app \
          --host 127.0.0.1 --port 8080 --workers 2
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s

# durcissement : le service ne lit qu'un index et n'ecrit nulle part
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
ReadWritePaths=/var/lib/osu-mapmatcher

[Install]
WantedBy=multi-user.target
